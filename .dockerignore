# ===========================================
# FiscalZen - Docker Ignore
# ===========================================

# Git
.git
.gitignore
.gitattributes

# Dependencies (serão instaladas no container)
node_modules
**/node_modules

# Build outputs (serão gerados no container)
dist
**/dist
build
**/build
.next
**/.next
.turbo
**/.turbo

# Environment files (NUNCA incluir no build)
.env
.env.*
*.env
!.env.example

# IDE e editores
.vscode
.idea
*.swp
*.swo
*~

# Testes e cobertura
coverage
**/__tests__
**/*.test.ts
**/*.spec.ts
**/*.test.tsx
**/*.spec.tsx
jest.config.*
vitest.config.*

# Docker (evita recursão)
docker/secrets/
Dockerfile*
docker-compose*

# Secrets (CRÍTICO - nunca incluir)
secrets/
*.pem
*.key
*.crt
*.p12
*.pfx
certs/

# Logs e temporários
*.log
logs/
tmp/
temp/
.cache
npm-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Documentação (não necessária no runtime)
*.md
docs/
LICENSE

# Monorepo configs (não necessários no runtime)
turbo.json
.npmrc
.nvmrc
.node-version
