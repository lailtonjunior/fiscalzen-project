{
  "name": "@fiscalzen/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/s3-request-presigner": "^3.490.0",
    "@fastify/autoload": "^5.8.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.0",
    "@fastify/multipart": "^8.1.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/websocket": "^10.0.1",
    "@fiscalzen/database": "workspace:*",
    "@fiscalzen/nfse-client": "workspace:*",
    "@fiscalzen/pdf-generator": "workspace:*",
    "@fiscalzen/sefaz-client": "workspace:*",
    "@fiscalzen/shared": "workspace:*",
    "@fiscalzen/xml-parser": "workspace:*",
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "bullmq": "^5.1.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.29.3",
    "fastify": "^4.25.2",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.3.2",
    "meilisearch": "^0.37.0",
    "p-limit": "^7.2.0",
    "bwip-js": "^4.3.0",
    "pdfmake": "^0.3.3",
    "qrcode": "^1.5.4",
    "pg": "^8.11.3",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bwip-js": "^3.2.3",
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.5",
    "@types/pdfmake": "^0.2.12",
    "@types/pg": "^8.16.0",
    "postgres": "^3.4.3",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
