# FiscalZen Environment Variables
# Copy this file to .env.local and fill in the values

# ===========================================
# Database (PostgreSQL)
# ===========================================
DATABASE_URL=postgresql://fiscalzen:fiscalzen@localhost:55432/fiscalzen

# ===========================================
# Redis
# ===========================================
REDIS_URL=redis://localhost:56379

# ===========================================
# S3-Compatible Storage (MinIO for dev)
# Credenciais devem coincidir com docker-compose.yml
# ===========================================
S3_ENDPOINT=http://localhost:59000
S3_ACCESS_KEY=fiscalzen
S3_SECRET_KEY=fiscalzen_minio_dev
S3_BUCKET=fiscalzen-docs
S3_REGION=us-east-1

# ===========================================
# Meilisearch
# API Key deve coincidir com docker-compose.yml
# ===========================================
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=fiscalzen_meilisearch_dev_key

# ===========================================
# Authentication (Clerk)
# ===========================================
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ===========================================
# API Configuration
# ===========================================
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ===========================================
# Frontend Configuration
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ===========================================
# JWT / Session
# IMPORTANTE: Gere um secret único para produção!
# Gerar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Ou use: node scripts/generate-secrets.js
# ===========================================
JWT_SECRET=dev_jwt_secret_change_in_production_minimum_32_characters
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# ===========================================
# SEFAZ Configuration
# ===========================================
# Certificate path (A1 - .pfx file)
SEFAZ_CERT_PATH=./certs/certificado.pfx
SEFAZ_CERT_PASSWORD=your-certificate-password

# Environment: 1 = Production, 2 = Homologation
SEFAZ_AMBIENTE=2

# ===========================================
# CORS Configuration
# ===========================================
# Origens permitidas (separadas por vírgula para múltiplas)
CORS_ORIGIN=http://localhost:3000
# Exemplo múltiplas origens: CORS_ORIGIN=http://localhost:3000,https://app.fiscalzen.com.br

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ===========================================
# Agent WebSocket
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ===========================================
AGENT_WS_PORT=3002
AGENT_TOKEN_SECRET=dev_agent_secret_change_in_production

# ===========================================
# Feature Flags
# ===========================================
ENABLE_NFSE_RPA=false
ENABLE_SEFAZ_MONITOR=true
ENABLE_SWAGGER=false
ENABLE_TRACING=false
# JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ===========================================
# Local development auth bypass
# DEV_TENANT_ID must match the tenant created by pnpm seed:dev.
# Never enable DISABLE_AUTH in production or shared demo environments.
# ===========================================
DISABLE_AUTH=false
DEV_TENANT_ID=00000000-0000-0000-0000-000000000000
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_USER_EMAIL=dev@local.test


# ===========================================
# Certificate encryption (A1 PFX)
# CRÍTICO: Sem esta chave, certificados não podem ser descriptografados!
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Ou use: node scripts/generate-secrets.js
# ===========================================
CERT_ENCRYPTION_KEY=ZGV2X2NlcnRfa2V5X2NoYW5nZV9pbl9wcm9kXzMy
