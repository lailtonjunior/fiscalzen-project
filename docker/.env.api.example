# ===========================================
# FiscalZen API - Environment Variables
# ===========================================
# Copie este arquivo para .env.api e ajuste os valores

# Configurações não-sensíveis podem ficar aqui
# Secrets são lidos de /run/secrets/* no container

# Logging
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Upload limits
MAX_FILE_SIZE_MB=10

# Feature flags
ENABLE_SWAGGER=false
ENABLE_METRICS=true
