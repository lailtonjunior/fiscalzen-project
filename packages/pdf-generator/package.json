{
    "name": "@fiscalzen/pdf-generator",
    "version": "0.1.0",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch --silent",
        "lint": "eslint . --ext .ts",
        "clean": "rimraf dist"
    },
    "dependencies": {
        "@fiscalzen/xml-parser": "workspace:*",
        "bwip-js": "^4.5.1",
        "pdfkit": "^0.15.0",
        "qrcode": "^1.5.4"
    },
    "devDependencies": {
        "@types/bwip-js": "^3.2.3",
        "@types/node": "^20.0.0",
        "@types/pdfkit": "^0.13.4",
        "@types/qrcode": "^1.5.5",
        "rimraf": "^5.0.0",
        "tsup": "^8.5.0",
        "typescript": "^5.0.0"
    }
}