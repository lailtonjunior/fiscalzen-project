{
    "name": "@fiscalzen/cli",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "bin": {
        "fiscalzen": "./dist/index.js"
    },
    "scripts": {
        "build": "tsup src/index.ts --format esm --dts --clean",
        "dev": "tsup src/index.ts --format esm --watch",
        "start": "node dist/index.js",
        "test": "vitest --passWithNoTests",
        "test:run": "vitest run --passWithNoTests",
        "lint": "eslint src --ext .ts",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@fiscalzen/sefaz-client": "workspace:*",
        "@fiscalzen/xml-parser": "workspace:*",
        "commander": "^12.0.0"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "tsup": "^8.0.1",
        "typescript": "^5.3.3",
        "vitest": "^1.2.0"
    }
}