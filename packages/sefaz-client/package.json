{
  "name": "@fiscalzen/sefaz-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch --silent",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fiscalzen/shared": "workspace:*",
    "@fiscalzen/xml-parser": "workspace:*",
    "@xmldom/xmldom": "^0.8.10",
    "axios": "^1.6.5",
    "https-proxy-agent": "^7.0.2",
    "node-forge": "^1.3.3",
    "xml-crypto": "^6.1.2",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/xml2js": "^0.4.14",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}